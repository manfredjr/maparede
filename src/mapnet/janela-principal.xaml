<!--
    Janela principal do MapNet - MT no leiaute C, o painel do tecnico
    (docs/superpowers/specs/2026-09-25-mapnet-0.2-painel-do-tecnico-design.md).
    A logica fica no PainelVarredura, no nucleo. Aqui so a aparencia e as ligacoes.
-->
<Window x:Class="MapNet.JanelaPrincipal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource JanelaMT}"
        Icon="pack://application:,,,/mapnet;component/recursos/mapnet.ico"
        Width="1180" Height="740" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Faixa do topo -->
        <Border Grid.Row="0" Background="{StaticResource GradienteFaixa}" Padding="16,10">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Left" Background="White" CornerRadius="8" Padding="6,4,10,4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/mapnet;component/recursos/mapnet-simbolo.png"
                               Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="MapNet" FontWeight="ExtraBold" FontSize="17" Margin="6,0,0,0"
                                   Foreground="{StaticResource PincelVerde}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BotaoPrincipal" Style="{StaticResource BotaoFaixa}" MinWidth="150"
                            Command="{Binding ComandoPrincipal}" Content="{Binding TextoBotaoPrincipal}" />
                    <Button x:Name="BotaoRelatorio" Style="{StaticResource BotaoFaixaContorno}" Content="Relatório"
                            Click="AoClicarRelatorio">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Abrir o relatório" Click="AoAbrirRelatorio"
                                          IsEnabled="{Binding PodeAbrirRelatorio}" />
                                <MenuItem Header="Salvar o relatório como..." Click="AoSalvarComo"
                                          IsEnabled="{Binding PodeSalvarComo}" />
                                <Separator />
                                <MenuItem Header="Abrir a pasta dos relatórios" Click="AoAbrirPasta" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>

                <DockPanel Margin="14,0,6,0" VerticalAlignment="Center">
                    <Button DockPanel.Dock="Right" Style="{StaticResource BotaoFaixaContorno}" Content="Atualizar"
                            Command="{Binding ComandoAtualizar}" ToolTip="Ler de novo as interfaces de rede" />
                    <ComboBox ItemsSource="{Binding Interfaces}"
                              SelectedItem="{Binding InterfaceSelecionada, Mode=TwoWay}"
                              DisplayMemberPath="Resumo"
                              IsEnabled="{Binding PodeTrocarInterface}"
                              FontSize="13" Padding="8,6" VerticalContentAlignment="Center"
                              ToolTip="Interface de rede que vai ser varrida" />
                </DockPanel>
            </DockPanel>
        </Border>

        <!-- Corpo -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="10" />
                <RowDefinition Height="200" />
            </Grid.RowDefinitions>

            <!-- Minha maquina -->
            <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="3" Style="{StaticResource Cartao}">
                <DockPanel>
                    <!-- Marca da MT fixa no pe da coluna, fora da rolagem. O clique abre manfred.com.br no navegador -->
                    <Button DockPanel.Dock="Bottom" x:Name="BotaoMarcaMt" Style="{StaticResource BotaoMarca}" Click="AoClicarMarcaMt"
                            HorizontalAlignment="Center" Margin="0,10,0,0" AutomationProperties.Name="MT - Manfred Tecnologia"
                            ToolTip="MT - Manfred Tecnologia. Abre o site manfred.com.br no navegador.">
                        <Image Source="pack://application:,,,/mapnet;component/recursos/mt-logo.png"
                               Height="72" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Button>
                    <!-- Consulta do IP publico fixa acima do logo, sempre a mostra -->
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource BotaoContorno}" HorizontalAlignment="Center" Margin="0,10,0,0"
                            Command="{Binding ComandoIpPublico}" Content="{Binding TextoBotaoIpPublico}"
                            ToolTip="Pergunta o IP público ao serviço 1.1.1.1, do Cloudflare. É a única consulta do programa fora da rede local." />
                    <Border DockPanel.Dock="Bottom" Height="1" Background="{StaticResource PincelBorda}" Margin="0,8,0,0" />
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Style="{StaticResource BarraTitulo}" />
                        <TextBlock Style="{StaticResource TituloCartao}" Text="Minha máquina" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding GruposMaquina}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Style="{StaticResource TituloGrupo}" Text="{Binding Titulo}" />
                                            <ItemsControl ItemsSource="{Binding Itens}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel>
                                                            <TextBlock Style="{StaticResource RotuloInfo}" Text="{Binding Rotulo}" />
                                                            <TextBox Style="{x:Null}" Text="{Binding Valor, Mode=OneWay}" IsReadOnly="True"
                                                                     BorderThickness="0" Background="Transparent" Padding="0" Margin="-2,0,0,0"
                                                                     FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Hosts da rede -->
            <Border Grid.Column="2" Grid.Row="0" Style="{StaticResource Cartao}" Padding="14,12,14,6">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Border Style="{StaticResource BarraTitulo}" />
                            <TextBlock Style="{StaticResource TituloCartao}" Text="{Binding TituloHosts}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="Filtrar:" VerticalAlignment="Center" Margin="0,0,6,0"
                                       Foreground="{StaticResource PincelTextoSuave}" />
                            <TextBox Width="220" Padding="6,4" VerticalContentAlignment="Center"
                                     Text="{Binding Filtro, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="IP, nome, MAC, fabricante ou observação" />
                        </StackPanel>
                    </DockPanel>
                    <DataGrid x:Name="TabelaHosts" Style="{StaticResource TabelaHosts}">
                        <DataGrid.Columns>
                            <!--
                                Larguras fixas pelo texto mais longo possivel: IP 255.255.255.255, "DNS reverso",
                                MAC com 17 caracteres e o titulo "Ping (ms)". Nome, Fabricante e Observacao
                                dividem o resto, com minimo para "MAC aleatorio (privativo)" e "Nao responde a ping".
                                Na largura padrao da janela, mesmo com a barra de rolagem vertical, nada disso fica cortado. Abaixo dela, aparece a rolagem
                                lateral. Texto maior que a coluna aparece inteiro na dica.
                            -->
                            <DataGridTextColumn Header="IP" Binding="{Binding Ip}" SortMemberPath="IpNumero" Width="118" MinWidth="118"
                                                FontFamily="{StaticResource FonteConsole}" ElementStyle="{StaticResource CelulaComDica}" />
                            <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="1.3*" MinWidth="90"
                                                ElementStyle="{StaticResource CelulaComDica}" />
                            <DataGridTextColumn Header="Origem" Binding="{Binding OrigemNome}" Width="96" MinWidth="96"
                                                ElementStyle="{StaticResource CelulaComDica}" />
                            <DataGridTextColumn Header="MAC" Binding="{Binding Mac}" Width="132" MinWidth="132"
                                                FontFamily="{StaticResource FonteConsole}" ElementStyle="{StaticResource CelulaComDica}" />
                            <DataGridTextColumn Header="Fabricante" Binding="{Binding Fabricante}" Width="1.6*" MinWidth="170"
                                                ElementStyle="{StaticResource CelulaComDica}" />
                            <DataGridTextColumn Header="Ping (ms)" Binding="{Binding Ping}" SortMemberPath="PingOrdem" Width="80" MinWidth="80" />
                            <DataGridTextColumn Header="Observação" Binding="{Binding Observacao}" Width="1.2*" MinWidth="150"
                                                ElementStyle="{StaticResource CelulaComDica}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Console -->
            <Border Grid.Column="2" Grid.Row="2" Background="{StaticResource PincelGrafite}" CornerRadius="10">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Background="#2B2B2B" Margin="0">
                        <Border DockPanel.Dock="Left" Background="{StaticResource PincelGrafite}" CornerRadius="6,6,0,0"
                                Margin="8,6,0,0" Padding="12,5">
                            <TextBlock Text="Varredura" FontWeight="SemiBold" FontSize="11.5"
                                       Foreground="{StaticResource PincelVerdeClaro}" />
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,8,4">
                            <Button Style="{StaticResource BotaoConsole}" Content="Copiar" Click="AoCopiarConsole"
                                    ToolTip="Copiar o registro para a área de transferência" />
                            <Button Style="{StaticResource BotaoConsole}" Content="Limpar" Click="AoLimparConsole" />
                        </StackPanel>
                    </DockPanel>
                    <ListBox x:Name="ListaConsole" ItemsSource="{Binding Console.Linhas}"
                             Background="Transparent" BorderThickness="0" Padding="8,6"
                             Foreground="{StaticResource PincelTextoConsole}"
                             FontFamily="{StaticResource FonteConsole}" FontSize="12"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="Padding" Value="0,1" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Barra de estado -->
        <Border Grid.Row="2" Background="{StaticResource PincelGrafite}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Height="3" Background="{StaticResource GradienteLinha}" />
                <StackPanel Orientation="Horizontal" Margin="14,6">
                    <TextBlock Style="{StaticResource TextoEstado}" Text="{Binding TextoAndamento}" MinWidth="200" />
                    <ProgressBar Style="{StaticResource ProgressoMT}" Value="{Binding Progresso, Mode=OneWay}"
                                 Maximum="100" Margin="0,0,18,0" />
                    <TextBlock Style="{StaticResource TextoEstado}" Text="{Binding TextoResumo}" />
                    <TextBlock Style="{StaticResource TextoEstado}" Text="{Binding TextoAviso}"
                               Foreground="{StaticResource PincelVerdeClaro}" />
                    <TextBlock Style="{StaticResource TextoEstado}" Text="{Binding TextoRelatorio}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
