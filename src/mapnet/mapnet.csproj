<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>mapnet</AssemblyName>
    <RootNamespace>MapNet</RootNamespace>
    <Description>MapNet - MT: inventario da rede local.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>recursos\mapnet.ico</ApplicationIcon>

    <!-- Entrega: um .exe unico, autocontido, para Windows 64 bits -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- Imagens e fonte da MT embutidas no .exe e lidas pela tela com pack:// -->
  <ItemGroup>
    <Resource Include="recursos\mapnet.ico" />
    <Resource Include="recursos\mapnet-simbolo.png" />
    <Resource Include="recursos\mt-logo.png" />
    <Resource Include="recursos\fontes\*.ttf" />
    <Resource Include="recursos\fontes\ofl.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\mapnet.nucleo\mapnet.nucleo.csproj" />
  </ItemGroup>

</Project>
